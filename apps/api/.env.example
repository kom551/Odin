# HTTP
PORT=3001
HOST=0.0.0.0

# 数据库（libSQL / Turso）
# 本地默认 file:data/odin.db（相对进程 cwd）；生产建议用 Turso 托管库：
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=eyJ...
DATABASE_URL=
# Turso 访问令牌（仅远程库需要）
DATABASE_AUTH_TOKEN=

# 任务审核系统
# 管理页面接口鉴权（必须配置，否则管理接口返回 403）
ADMIN_KEY=
# 审核失败重试退避基数（毫秒，默认 1000）
REVIEW_RETRY_BASE_MS=1000
# 上游 LLM 请求超时（毫秒，默认 60000）
LLM_HTTP_TIMEOUT_MS=60000
# 图片上传根目录（仅本地/nginx 部署的兜底存储；Vercel 上配 BLOB_READ_WRITE_TOKEN 走 Blob）
UPLOAD_DIR=
# 客户端访问码签发的设备令牌有效期（天，默认 30）
ACCESS_TOKEN_TTL_DAYS=30

# ============ 自定义大模型（OpenAI 兼容接口，任务审核用） ============
# Base URL（必填）：指向 OpenAI 兼容 chat/completions 服务，如 https://your-llm.example.com/v1
LLM_BASE_URL=
# 模型名称（必填）：如 gpt-4o-mini / deepseek-chat / 自建模型名
LLM_MODEL=
# API Key（可选）：自建服务无需鉴权时可留空
LLM_API_KEY=

# ============ Vercel Blob（可选，Vercel 部署时由 Blob 存储集成自动注入） ============
# 配置后图片上传写入 Blob 并返回公开 URL；未配置时回退到 UPLOAD_DIR 本地存储
BLOB_READ_WRITE_TOKEN=
